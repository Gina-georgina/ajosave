# Full reference with descriptions and required/optional status:
# docs/environment-variables.md

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=STELLAR

# ─── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_strong_random_secret

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/stellar
DB_POOL_SIZE=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_MAX_RETRIES=3
DB_RETRY_DELAY_MS=500

# ─── Stellar / Soroban ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_HORIZON_FALLBACK_URL=
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_AJO_CONTRACT_ID=replace_with_deployed_contract_id
STELLAR_CERTIFICATE_CONTRACT_ID=
STELLAR_SERVER_SECRET_KEY=replace_with_stellar_secret_key
STELLAR_MAX_FEE_CAP=200
ENABLE_HORIZON_STREAM=false
ENABLE_EVENT_INDEXER=false
EVENT_INDEXER_POLL_MS=5000

# ─── USDC ──────────────────────────────────────────────────────────────────────
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC
SLIPPAGE_TOLERANCE_PERCENT=0.5

# ─── Payments ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
PAYSTACK_PLATFORM_SUBACCOUNT=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=replace_with_paystack_public_key
PLATFORM_FEE_PERCENT=0

# ─── SMS / OTP ─────────────────────────────────────────────────────────────────
TERMII_API_KEY=replace_with_termii_api_key
TERMII_SENDER_ID=STELLAR

# ─── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ajosave <noreply@ajosave.app>

# ─── KYC ───────────────────────────────────────────────────────────────────────
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_CALLBACK_URL=
KYC_THRESHOLD_NGN=100000

# ─── Redis / background jobs ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
OUTBOX_BATCH_LIMIT=50
OUTBOX_MAX_ATTEMPTS=5
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# ─── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=replace_with_cron_secret

# ─── Security / PII ──────────────────────────────────────────────────────────────
PII_ENCRYPTION_KEY=replace_with_pii_encryption_key
PII_HMAC_KEY=replace_with_pii_hmac_key
ALLOWED_ORIGINS=

# ─── Observability ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Wallet ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── FX / Slippage Guard (#222) ────────────────────────────────────────────────
# Maximum acceptable deviation (%) between quoted and live rate before aborting.
FX_SLIPPAGE_THRESHOLD_PCT=2
# How long (seconds) a quoted rate is considered valid (rate-lock window).
FX_QUOTE_TTL_SECONDS=60
